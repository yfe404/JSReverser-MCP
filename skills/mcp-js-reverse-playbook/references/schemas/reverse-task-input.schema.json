{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://js-reverse-mcp.local/schemas/reverse-task-input.schema.json",
  "title": "Reverse Task Input Contract",
  "description": "Site-agnostic reverse task input contract. Only desensitized seeds are allowed; no real sensitive values.",
  "type": "object",
  "required": [
    "target",
    "request",
    "runtime",
    "verify"
  ],
  "additionalProperties": false,
  "properties": {
    "target": {
      "type": "object",
      "required": [
        "site",
        "entryType",
        "entryName"
      ],
      "additionalProperties": false,
      "properties": {
        "site": {
          "type": "string",
          "minLength": 1,
          "description": "Site identifier, e.g. jd / tiktok / xhs"
        },
        "scriptUrl": {
          "type": "string",
          "format": "uri",
          "description": "Signing script URL (optional, may be empty during dynamic capture)"
        },
        "entryType": {
          "type": "string",
          "enum": [
            "function",
            "class-method",
            "expression"
          ],
          "description": "Signing entry type"
        },
        "entryName": {
          "type": "string",
          "minLength": 1,
          "description": "Signing entry name, e.g. sign / ParamsSignMain.sign"
        },
        "signatureField": {
          "type": "string",
          "description": "Output signature field name, e.g. h5st / x-bogus / msToken"
        },
        "targetUrlPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "targetKeywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "url",
        "method",
        "paramsTemplate"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "PATCH"
          ]
        },
        "paramsTemplate": {
          "type": "object",
          "description": "Pre-signing request template (can be desensitized), retaining only structure and necessary placeholders"
        },
        "headersTemplate": {
          "type": "object",
          "default": {},
          "description": "Request headers template, real tokens/cookies are forbidden"
        },
        "bodyTemplate": {
          "description": "Request body template (optional)"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "seedMode"
      ],
      "additionalProperties": false,
      "properties": {
        "seedMode": {
          "type": "string",
          "enum": [
            "none",
            "keys-only",
            "masked-values"
          ],
          "description": "Runtime seed mode"
        },
        "seedKeys": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Key names only. Recommended to include key names from three categories: cookies/localStorage/sessionStorage"
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "system",
                "fixed"
              ],
              "default": "system"
            },
            "fixedNow": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "environmentHints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Environment hints, e.g. requires-canvas / requires-webgl"
        }
      }
    },
    "verify": {
      "type": "object",
      "required": [
        "enabled",
        "expectStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "expectStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "expectBodyContains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 1
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbidRawSecrets": {
          "type": "boolean",
          "default": true
        },
        "forbidRawCookies": {
          "type": "boolean",
          "default": true
        },
        "forbidRawTokens": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
